DISCORD_TOKEN=
COC_API_TOKEN=
OWNER_ID=
# Optional: sync only on explicit launch with --sync; faster in one server.
GUILD_ID=
DATABASE_PATH=data/kai_bot.db
# Enable both these intents in Discord Developer Portal if set to true.
MEMBERS_INTENT=false
MESSAGE_CONTENT_INTENT=false
# Separate, PRIVATE repository for encrypted data backups (never the public code repo).
BACKUP_REPOSITORY=
BACKUP_GITHUB_TOKEN=
BACKUP_ENCRYPTION_KEY=
# Optional recovered tournament module; read docs/CUP.md first.
ENABLE_CUP=false
